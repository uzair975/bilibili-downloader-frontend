---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const thumbnailFaqs = [
  {
    question: "How do I download a Bilibili cover image in HD?",
    answer: "Simply copy the video link from Bilibili (desktop URL or mobile b23.tv share link), paste it into our Bilibili Thumbnail Downloader, and click 'Get Cover Image'. You can then save the original full-resolution cover image directly to your device."
  },
  {
    question: "What resolution are Bilibili video thumbnails?",
    answer: "Bilibili creators typically upload thumbnails in high-definition 16:9 aspect ratio, ranging from 1280x720 (720p) up to 1920x1080 (1080p Full HD) or higher, hosted directly on Bilibili's CDN without watermarks."
  },
  {
    question: "Can I download cover images using mobile b23.tv links?",
    answer: "Yes! BiliExtract automatically unrolls mobile b23.tv shortlinks, cleans any promotional Chinese text, and extracts the original high-resolution cover artwork."
  },
  {
    question: "Do I need to log into Bilibili to download covers?",
    answer: "No. Our tool queries Bilibili's public media metadata, allowing you to extract and download thumbnails 100% free without logging in or using cookies."
  }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Bilibili Thumbnail Downloader - Free HD Cover Image Extractor",
    "url": "https://biliextract.me/bilibili-thumbnail-downloader/",
    "applicationCategory": "MultimediaApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript. Requires HTML5.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "Download high-resolution Bilibili video cover images and anime thumbnails in 1080p HD without watermarks or login."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": thumbnailFaqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  }
];
---

<BaseLayout
  title="Bilibili Thumbnail Downloader - Download Bilibili Cover Image HD"
  description="Free Bilibili thumbnail downloader. Extract and save high-resolution video cover images and anime artwork in original HD quality without watermarks."
  canonical="https://biliextract.me/bilibili-thumbnail-downloader/"
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="tool-hero">
    <div class="container hero-container">
      <div class="badge-tag">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
        HD Cover Image Extractor
      </div>

      <h1 class="tool-title">
        Bilibili <span class="text-gradient">Thumbnail Downloader</span>
      </h1>
      <p class="tool-subtitle">
        Download Bilibili cover images in original HD quality. Extract anime artwork, YouTube-style thumbnails, and video posters without watermarks or account login.
      </p>

      <!-- Input Form -->
      <div class="thumb-form-card">
        <form id="thumb-form" class="thumb-form">
          <div class="input-wrapper">
            <div class="input-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
            </div>

            <input
              type="url"
              id="thumb-url-input"
              class="thumb-url-input"
              placeholder="Paste Bilibili video link (e.g., bilibili.com/video/BV... or b23.tv/...)"
              required
              autocomplete="off"
            />

            <button type="button" id="thumb-paste-btn" class="thumb-paste-btn" title="Paste link">
              Paste
            </button>
          </div>

          <button type="submit" id="thumb-submit-btn" class="btn-primary thumb-submit-btn">
            <span class="btn-text">Get Cover Image</span>
            <span class="spinner" style="display: none;">
              <svg class="animate-spin" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
                <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"></path>
              </svg>
            </span>
          </button>
        </form>

        <div id="thumb-error" class="form-error" style="display: none;">
          <span id="thumb-error-msg">Failed to retrieve thumbnail. Please check the URL.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Thumbnail Result Display -->
  <section id="thumb-result-section" class="thumb-result-section" style="display: none;">
    <div class="container result-container">
      <div class="card result-card">
        <div class="preview-wrapper">
          <img id="thumb-img-preview" src="" alt="Bilibili HD Cover Image" class="thumb-preview-img" referrerpolicy="no-referrer" />
          <div class="preview-overlay">
            <span class="badge-tag">Original Resolution</span>
          </div>
        </div>

        <div class="result-details">
          <h2 id="thumb-video-title" class="result-title">Bilibili Video Title</h2>
          <p id="thumb-video-author" class="result-author">Creator: <span>...</span></p>

          <div class="action-buttons">
            <a id="thumb-download-btn" href="#" target="_blank" rel="noopener" class="btn-primary">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Download Cover Image (HD)
            </a>

            <a id="thumb-raw-btn" href="#" target="_blank" rel="noopener" class="btn-secondary">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              Open Full Size in New Tab
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How-To & Informational Content Section -->
  <section class="info-section">
    <div class="container content-container">
      <div class="card content-card">
        <h2>How to Download Bilibili Cover Image in HD</h2>
        <p>
          Bilibili creators design custom, eye-catching thumbnails for their videos, anime reviews, and gameplay montages.
          Unlike other platforms that compress thumbnails or overlay black bars, Bilibili hosts pristine, full-resolution artwork on their media CDN.
        </p>

        <div class="steps-grid">
          <div class="step-box">
            <div class="step-num">1</div>
            <h3>Copy Bilibili Video Link</h3>
            <p>On your desktop browser, copy the URL from the address bar. On the mobile app, tap the <strong>Share</strong> icon and tap <strong>Copy Link</strong>.</p>
          </div>

          <div class="step-box">
            <div class="step-num">2</div>
            <h3>Paste into Thumbnail Downloader</h3>
            <p>Paste the copied link or BV identifier into the input field above and click <strong>Get Cover Image</strong>.</p>
          </div>

          <div class="step-box">
            <div class="step-num">3</div>
            <h3>Save Original HD Image</h3>
            <p>Click <strong>Download Cover Image (HD)</strong> to instantly save the uncompressed JPG/PNG image to your phone or computer.</p>
          </div>
        </div>

        <hr class="divider" />

        <h2>Why Use Our Bilibili Thumbnail Downloader?</h2>
        <ul class="feature-bullets">
          <li><strong>Original Master Quality:</strong> Direct access to the uncompressed source image file uploaded by the video author.</li>
          <li><strong>No Watermarks:</strong> Retrieve clean artwork free from play buttons, timestamps, or logos.</li>
          <li><strong>Mobile Shortlink Support:</strong> Automatically parses and unrolls <code>b23.tv</code> app links.</li>
          <li><strong>Zero Installation &amp; Free:</strong> 100% web-based. No browser extensions, software, or accounts needed.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <div class="container faq-wrap">
    <FaqAccordion faqs={thumbnailFaqs} />
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('thumb-form');
  const input = document.getElementById('thumb-url-input') as HTMLInputElement | null;
  const pasteBtn = document.getElementById('thumb-paste-btn');
  const submitBtn = document.getElementById('thumb-submit-btn');
  const btnText = submitBtn?.querySelector('.btn-text');
  const spinner = submitBtn?.querySelector('.spinner');
  const errorBox = document.getElementById('thumb-error');
  const errorMsg = document.getElementById('thumb-error-msg');

  const resultSection = document.getElementById('thumb-result-section');
  const imgPreview = document.getElementById('thumb-img-preview') as HTMLImageElement | null;
  const videoTitle = document.getElementById('thumb-video-title');
  const videoAuthor = document.getElementById('thumb-video-author');
  const downloadBtn = document.getElementById('thumb-download-btn') as HTMLAnchorElement | null;
  const rawBtn = document.getElementById('thumb-raw-btn') as HTMLAnchorElement | null;

  // Paste from clipboard
  pasteBtn?.addEventListener('click', async () => {
    try {
      const text = await navigator.clipboard.readText();
      if (text && input) {
        input.value = text.trim();
        input.focus();
      }
    } catch (e) {
      console.warn('Clipboard read error', e);
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const url = input?.value.trim();
    if (!url) return;

    if (errorBox) errorBox.style.display = 'none';
    if (submitBtn) (submitBtn as HTMLButtonElement).disabled = true;
    if (btnText) btnText.textContent = 'Extracting...';
    if (spinner) (spinner as HTMLElement).style.display = 'inline-flex';

    try {
      const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
      const apiBase = isLocal ? 'http://127.0.0.1:8000' : 'https://bilibili-downloader-backend-vpif.onrender.com';
      const apiUrl = `${apiBase}/api/v1/resolve`;
      const downloadEndpoint = `${apiBase}/api/v1/download`;

      const resp = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url })
      });

      let data = null;
      try {
        data = await resp.json();
      } catch (jsonErr) {
        throw new Error(resp.status === 502 || resp.status === 504 
          ? 'Backend is waking up. Please retry in a few seconds.' 
          : `Server returned error (${resp.status}). Please try again.`);
      }

      if (!resp.ok || !data || !data.thumbnail) {
        throw new Error(data?.error || data?.detail || 'Could not find thumbnail for this video.');
      }

      // Setup download links
      const rawCoverUrl = data.thumbnail;
      const cleanTitle = (data.title || 'bilibili_cover').replace(/[\\/*?:"<>|]/g, '_').slice(0, 50);

      const proxiedDownload = `${downloadEndpoint}?url=${encodeURIComponent(rawCoverUrl)}&filename=${encodeURIComponent(cleanTitle + '_cover.jpg')}&type=image`;

      // Display preview with fallback proxy
      if (imgPreview) {
        imgPreview.referrerPolicy = 'no-referrer';
        imgPreview.src = data.thumbnail;
        imgPreview.onerror = () => {
          if (!imgPreview.src.includes('/api/v1/download')) {
            imgPreview.src = proxiedDownload;
          }
        };
      }
      if (videoTitle) videoTitle.textContent = data.title || 'Bilibili Video';
      if (videoAuthor) {
        const span = videoAuthor.querySelector('span');
        if (span) span.textContent = data.author_name || 'Creator';
      }

      if (downloadBtn) {
        downloadBtn.href = proxiedDownload;
        downloadBtn.setAttribute('download', `${cleanTitle}_cover.jpg`);
      }

      if (rawBtn) {
        rawBtn.href = rawCoverUrl;
      }

      if (resultSection) {
        resultSection.style.display = 'block';
        resultSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

    } catch (err: any) {
      if (errorBox && errorMsg) {
        errorMsg.textContent = err.message || 'Failed to extract thumbnail. Please verify your link.';
        errorBox.style.display = 'flex';
      }
    } finally {
      if (submitBtn) (submitBtn as HTMLButtonElement).disabled = false;
      if (btnText) btnText.textContent = 'Get Cover Image';
      if (spinner) (spinner as HTMLElement).style.display = 'none';
    }
  });
</script>

<style>
  .tool-hero {
    padding: 60px 0 32px;
    text-align: center;
    background: radial-gradient(circle at 50% 10%, rgba(255, 107, 0, 0.06) 0%, rgba(255, 255, 255, 0) 70%);
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 840px;
  }

  .tool-title {
    font-size: 2.6rem;
    font-weight: 800;
    margin: 18px 0 12px;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .tool-subtitle {
    font-size: 1.12rem;
    color: var(--text-secondary);
    max-width: 660px;
    margin-bottom: 32px;
    line-height: 1.6;
  }

  /* Form Card */
  .thumb-form-card {
    width: 100%;
    max-width: 780px;
    background: var(--bg-surface);
    border: 2px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 14px;
    box-shadow: var(--shadow-lg);
  }

  .thumb-form {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .input-wrapper {
    flex: 1;
    display: flex;
    align-items: center;
    background: var(--bg-surface-alt);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 6px 16px;
    gap: 10px;
    transition: all var(--transition-fast);
  }

  .input-wrapper:focus-within {
    background: #ffffff;
    border-color: var(--orange-500);
    box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.12);
  }

  .input-icon {
    color: var(--orange-500);
    display: flex;
    align-items: center;
  }

  .thumb-url-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 1rem;
    color: var(--text-primary);
    padding: 8px 0;
  }

  .thumb-paste-btn {
    border: none;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--rose-600);
    padding: 6px 12px;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .thumb-paste-btn:hover {
    background: var(--rose-50);
    border-color: var(--rose-500);
  }

  .thumb-submit-btn {
    padding: 14px 26px;
    font-size: 1rem;
    white-space: nowrap;
    min-width: 170px;
  }

  /* Result Section */
  .thumb-result-section {
    padding: 30px 0 40px;
  }

  .result-container {
    max-width: 820px;
  }

  .result-card {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    border-radius: var(--radius-lg);
  }

  .preview-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-surface-alt);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-subtle);
  }

  .thumb-preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-overlay {
    position: absolute;
    top: 12px;
    right: 12px;
  }

  .result-details {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .result-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .result-author {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .result-author span {
    font-weight: 700;
    color: var(--text-primary);
  }

  .action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }

  /* Content Section */
  .info-section {
    padding: 40px 0;
  }

  .content-container {
    max-width: 820px;
  }

  .content-card {
    padding: 40px;
  }

  .content-card h2 {
    font-size: 1.55rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 14px;
  }

  .content-card p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin: 28px 0;
  }

  .step-box {
    background: var(--bg-surface-alt);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 20px;
  }

  .step-num {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--gradient-primary);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.95rem;
    margin-bottom: 12px;
  }

  .step-box h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .step-box p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.55;
  }

  .divider {
    border: 0;
    height: 1px;
    background: var(--border-subtle);
    margin: 32px 0;
  }

  .feature-bullets {
    margin-left: 20px;
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.8;
  }

  .feature-bullets li {
    margin-bottom: 8px;
  }

  .feature-bullets strong {
    color: var(--text-primary);
  }

  .faq-wrap {
    max-width: 820px;
    margin-bottom: 60px;
  }

  @media (max-width: 720px) {
    .thumb-form {
      flex-direction: column;
    }
    .input-wrapper, .thumb-submit-btn {
      width: 100%;
    }
    .action-buttons {
      flex-direction: column;
    }
    .action-buttons a {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }
</style>
