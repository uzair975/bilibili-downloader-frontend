---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DownloaderForm from '../../components/DownloaderForm.astro';
import StreamResults from '../../components/StreamResults.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';

const audioFaqs = [
  {
    question: "What audio bitrate do you extract from Bilibili videos?",
    answer: "We extract the maximum available audio stream quality directly from Bilibili's DASH manifest, up to 320 kbps (High Fidelity) and 192 kbps studio audio, with fallback to standard 128 kbps."
  },
  {
    question: "Can I extract audio from anime songs and gaming streams?",
    answer: "Yes, any public Bilibili music video, anime OST, vocaloid track, or live stream VOD can be converted to MP3/M4A."
  },
  {
    question: "Is there any audio compression or loss of quality during conversion?",
    answer: "No re-encoding compression is performed. You receive the exact untouched high-bitrate AAC/MP4A stream as uploaded by the content creator."
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "BiliExtract - Bilibili to MP3 Audio Converter",
  "url": "https://biliextract.me/tools/bilibili-to-mp3/",
  "applicationCategory": "AudioApplication",
  "operatingSystem": "All",
  "description": "Convert Bilibili videos to MP3 audio online for free. Extract background music, anime songs, and voice tracks in high quality 320kbps / M4A formats."
};
---

<BaseLayout
  title="Bilibili to MP3 Converter — Extract High Quality Audio (320kbps)"
  description="Convert Bilibili videos to MP3 audio online for free. Extract background music, anime songs, and voice tracks in high quality 320kbps / M4A formats."
  canonical="https://biliextract.me/tools/bilibili-to-mp3/"
  jsonLd={jsonLd}
>
  <section class="tool-hero">
    <div class="container hero-container">
      <div class="badge-tag">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
        </svg>
        Lossless Audio Extraction
      </div>
      <h1 class="tool-title">
        <span class="text-gradient">Bilibili to MP3</span> Audio Converter
      </h1>
      <p class="tool-subtitle">
        Extract crystal-clear music, anime themes, ASMR, and vocal tracks directly from Bilibili videos in seconds.
      </p>

      <div class="form-box">
        <DownloaderForm
          placeholder="Paste Bilibili link to extract MP3 audio..."
          buttonText="Extract MP3"
          initialFormat="audio"
        />
      </div>
    </div>
  </section>

  <div class="container">
    <StreamResults />
  </div>

  <section class="info-content-section">
    <div class="container">
      <div class="card content-card">
        <h2>Why Use BiliExtract for Bilibili MP3 Downloads?</h2>
        <p>
          Bilibili is home to thousands of original music tracks, Vocaloid songs, anime OSTs, and independent indie musicians.
          However, listening offline or on portable music players can be challenging without extracting pure audio files.
        </p>
        <p>
          BiliExtract's dedicated audio engine detects the isolated audio stream encoded in AAC / MP4A format inside Bilibili's DASH stream manifest,
          bypassing video bloat to deliver pure, high-fidelity sound.
        </p>

        <div class="formats-list-box">
          <h3>Supported Audio Output Formats</h3>
          <ul class="formats-bullet-list">
            <li>
              <strong>.MP3 (MPEG-3 Audio):</strong> Universal compatibility across all smartphones, car stereos, and digital audio workstations with studio bitrates up to 320kbps.
            </li>
            <li>
              <strong>.M4A (MPEG-4 Audio Container):</strong> Direct DASH audio stream wrapper retaining native high-bitrate audio metadata with zero transcoding artifacts.
            </li>
            <li>
              <strong>.AAC (Advanced Audio Coding):</strong> Pure native Bilibili stream encoding offering optimum acoustic transparency, low harmonic distortion, and full frequency response.
            </li>
          </ul>
        </div>

        <div class="perks-row">
          <div class="perk-box">
            <strong>320 kbps High Bitrate</strong>
            <span>Studio quality preservation without clipping.</span>
          </div>
          <div class="perk-box">
            <strong>No Conversion Wait Time</strong>
            <span>Instant stream retrieval without server-side rendering queues.</span>
          </div>
          <div class="perk-box">
            <strong>ID3 Metadata Ready</strong>
            <span>Preserves original creator and song title information.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <FaqAccordion faqs={audioFaqs} />
  </div>
</BaseLayout>

<style>
  .tool-hero {
    padding: 60px 0 24px;
    text-align: center;
    background: radial-gradient(circle at 50% 10%, rgba(244, 63, 94, 0.05) 0%, rgba(255, 255, 255, 0) 70%);
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tool-title {
    font-size: 2.8rem;
    font-weight: 800;
    margin: 16px 0;
    color: var(--text-primary);
  }

  .tool-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 640px;
    margin-bottom: 32px;
  }

  .form-box {
    width: 100%;
  }

  .info-content-section {
    padding: 40px 0;
  }

  .content-card {
    padding: 40px;
  }

  .content-card h2 {
    font-size: 1.6rem;
    font-weight: 800;
    margin-bottom: 16px;
    color: var(--text-primary);
  }

  .content-card p {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .formats-list-box {
    margin: 24px 0;
    padding: 24px 28px;
    background: var(--bg-surface-alt);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .formats-list-box h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 14px;
  }

  .formats-bullet-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .formats-bullet-list li {
    position: relative;
    padding-left: 20px;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .formats-bullet-list li::before {
    content: "•";
    position: absolute;
    left: 4px;
    top: 0;
    color: var(--rose-500);
    font-size: 1.2rem;
    line-height: 1.6;
  }

  .formats-bullet-list strong {
    color: var(--text-primary);
  }

  .perks-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 28px;
  }

  .perk-box {
    background: var(--bg-surface-alt);
    border: 1px solid var(--border-subtle);
    padding: 20px;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .perk-box strong {
    color: var(--orange-500);
    font-size: 1.05rem;
  }

  .perk-box span {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .tool-title {
      font-size: 2.1rem;
    }
    .perks-row {
      grid-template-columns: 1fr;
    }
  }
</style>
