---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DownloaderForm from '../../components/DownloaderForm.astro';
import StreamResults from '../../components/StreamResults.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';

const hdFaqs = [
  {
    question: "Can I download 1080p 60FPS Bilibili videos?",
    answer: "Yes, if the original creator uploaded high-frame-rate content (60FPS), BiliExtract detects and lists the 1080P 60FPS stream option."
  },
  {
    question: "Why do some downloaders only give 360p or 480p?",
    answer: "Standard scrapers only capture low-resolution legacy MP4 fallbacks. BiliExtract parses Bilibili's modern DASH video container to retrieve full 1080P Full HD and 720P streams."
  },
  {
    question: "Which video codec is best: AVC / H.264, HEVC, or AV1?",
    answer: "H.264 (AVC) offers the highest compatibility across all televisions, smart devices, and older editing software. HEVC and AV1 offer superior compression efficiency."
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "BiliExtract - 1080p Full HD Bilibili Video Downloader",
  "url": "https://biliextract.me/tools/bilibili-1080p-hd/",
  "applicationCategory": "MultimediaApplication",
  "operatingSystem": "All",
  "description": "Download Bilibili videos in 1080p Full HD and 60FPS MP4 quality. Fast, free online video extractor without account login or app installation required."
};
---

<BaseLayout
  title="Bilibili 1080p HD Video Downloader — Save Full HD MP4 Online"
  description="Download Bilibili videos in 1080p Full HD and 60FPS MP4 quality. Fast, free online video extractor without account login or app installation required."
  canonical="https://biliextract.me/tools/bilibili-1080p-hd/"
  jsonLd={jsonLd}
>
  <section class="tool-hero">
    <div class="container hero-container">
      <div class="badge-tag">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="23 7 16 12 23 17 23 7"></polygon>
          <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
        </svg>
        Full HD 1080p & 60FPS
      </div>
      <h1 class="tool-title">
        <span class="text-gradient">Bilibili 1080p Full HD</span> Video Downloader
      </h1>
      <p class="tool-subtitle">
        Preserve every frame in crisp 1080p resolution. High bitrate, 60fps support, and seamless sound extraction.
      </p>

      <div class="form-box">
        <DownloaderForm
          placeholder="Paste Bilibili video URL for 1080p HD download..."
          buttonText="Download 1080p"
          initialFormat="video"
        />
      </div>
    </div>
  </section>

  <div class="container">
    <StreamResults />
  </div>

  <section class="info-content-section">
    <div class="container">
      <!-- DASH Stream Sync Explanation Box -->
      <div class="card sync-explanation-card">
        <div class="sync-badge">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="23 4 23 10 17 10"></polyline>
            <polyline points="1 20 1 14 7 14"></polyline>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
          </svg>
          DASH Video & Audio Stream Synchronization
        </div>
        <h2>How Our Engine Handles 1080p DASH Streams</h2>
        <p>
          Bilibili serves high-definition 1080p, 4K, and 60FPS video using <strong>DASH (Dynamic Adaptive Streaming over HTTP)</strong>. In this architecture, Bilibili intentionally splits high-definition video and audio tracks into two separate, concurrent streams to save streaming bandwidth. Standard video downloaders often fetch only the visual track, resulting in silent videos.
        </p>
        <p>
          <strong>The BiliExtract Solution:</strong> Our parsing engine inspects and synchronizes both the isolated 1080p video container and high-bitrate audio track simultaneously. We provide direct access to synced unified MP4 streams, as well as standalone high-bitrate video and 320kbps audio files—eliminating desync issues without requiring complex command-line tools.
        </p>
      </div>

      <div class="card content-card">
        <h2>Uncompromised High-Definition Visuals</h2>
        <p>
          Bilibili represents the largest anime, gaming, and creative video hub in Asia.
          Watching videos in 360p or 480p degrades gameplay footage and animation clarity.
        </p>
        <p>
          With BiliExtract, you gain direct access to the 1080p stream bitrate. We support H.264/AVC, HEVC, and modern AV1 codecs,
          ensuring maximum video clarity whether you are archiving educational lectures or high-octane gaming montages.
        </p>
      </div>
    </div>
  </section>

  <div class="container">
    <FaqAccordion faqs={hdFaqs} />
  </div>
</BaseLayout>

<style>
  .tool-hero {
    padding: 60px 0 24px;
    text-align: center;
    background: radial-gradient(circle at 50% 10%, rgba(255, 107, 0, 0.05) 0%, rgba(255, 255, 255, 0) 70%);
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tool-title {
    font-size: 2.8rem;
    font-weight: 800;
    margin: 16px 0;
    color: var(--text-primary);
  }

  .tool-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 640px;
    margin-bottom: 32px;
  }

  .form-box {
    width: 100%;
  }

  .info-content-section {
    padding: 40px 0;
  }

  .sync-explanation-card {
    padding: 36px 40px;
    margin-bottom: 28px;
    background: linear-gradient(135deg, rgba(255, 107, 0, 0.05) 0%, rgba(244, 63, 94, 0.03) 100%), var(--bg-surface);
    border: 1px solid rgba(255, 107, 0, 0.2);
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
  }

  .sync-explanation-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--gradient-primary);
  }

  .sync-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(255, 107, 0, 0.1);
    color: var(--orange-500);
    border: 1px solid rgba(255, 107, 0, 0.25);
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 16px;
  }

  .sync-explanation-card h2 {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 14px;
    color: var(--text-primary);
  }

  .sync-explanation-card p {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 12px;
  }

  .sync-explanation-card p:last-child {
    margin-bottom: 0;
  }

  .content-card {
    padding: 40px;
  }

  .content-card h2 {
    font-size: 1.6rem;
    font-weight: 800;
    margin-bottom: 16px;
    color: var(--text-primary);
  }

  .content-card p {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  @media (max-width: 768px) {
    .tool-title {
      font-size: 2.1rem;
    }
  }
</style>
