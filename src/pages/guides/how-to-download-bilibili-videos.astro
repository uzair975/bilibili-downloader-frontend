  }

  /* Callout & TOC */
  .highlight-callout {
    background: linear-gradient(135deg, rgba(255, 107, 0, 0.08), rgba(244, 63, 94, 0.06));
    border: 1px solid rgba(255, 107, 0, 0.25);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    margin-bottom: 32px;
