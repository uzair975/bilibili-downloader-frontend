    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .format-table th {
    background: var(--bg-surface-alt);
    padding: 12px 16px;
    text-align: left;
    font-weight: 700;
    color: var(--text-primary);
    border-bottom: 2px solid var(--border-subtle);
  }

  .format-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border-subtle);
