---
import BaseLayout from '../../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Download Bilibili Videos on PC and Mac",
  "description": "Step-by-step tutorial on downloading full HD 1080p Bilibili videos to Windows PC and Mac using BiliExtract.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Copy the Bilibili Link",
      "text": "Navigate to Bilibili in your web browser, locate the video, and copy the full URL from the address bar or share button."
    },
    {
      "@type": "HowToStep",
      "name": "Paste URL into BiliExtract",
      "text": "Visit BiliExtract, paste the copied link into the input bar, and click 'Download Now'."
    },
    {
      "@type": "HowToStep",
      "name": "Choose Quality and Save",
      "text": "Select 1080p Full HD or MP3 and click Download to save the file to your downloads directory."
    }
  ]
};
---

<BaseLayout
  title="How to Download Bilibili Videos on PC & Mac (Step-by-Step Guide)"
  description="Learn how to download Bilibili videos on Windows PC and Mac in 1080p HD or MP3 audio format with zero software installation."
  canonical="https://biliextract.com/guides/how-to-download-bilibili-pc/"
  jsonLd={jsonLd}
>
  <article class="guide-article">
    <div class="container guide-container">
      <div class="badge-tag">Tutorial & Guide</div>
      <h1 class="guide-title">How to Download Bilibili Videos on PC & Mac</h1>
      <p class="guide-meta">Updated for 2026 • 3 Min Read • Tested on Windows 11 & macOS Sonoma</p>

      <div class="card guide-body">
        <p class="lead">
          Downloading content from Bilibili on a desktop computer gives you the highest fidelity video experience.
          Whether you want to archive tutorials, anime episodes, or gaming commentary, follow these simple steps to save files directly.
        </p>

        <h2>Step 1: Obtain the Bilibili Video URL</h2>
        <p>
          Open your preferred browser (Chrome, Edge, Firefox, or Safari) and navigate to the Bilibili video page.
          You can copy the URL directly from your browser's address bar (e.g. <code>https://www.bilibili.com/video/BV1...</code>) or click the Share icon beneath the video player and choose <strong>Copy Link</strong>.
        </p>

        <h2>Step 2: Enter the Link on BiliExtract</h2>
        <p>
          Head over to <a href="/" class="text-link">BiliExtract.com</a>. Paste your link into the primary search bar at the top of the page.
          Click the orange <strong>Download Now</strong> button.
        </p>

        <h2>Step 3: Pick Your Resolution and Download</h2>
        <p>
          Our extractor inspects the video manifest in real-time. In the results table:
        </p>
        <ul>
          <li><strong>For Video:</strong> Click the <em>Download MP4</em> button next to 1080P Full HD or 720P HD.</li>
          <li><strong>For Audio Only:</strong> Switch to the <em>Audio</em> tab and download 320 kbps MP3.</li>
        </ul>

        <div class="tip-box">
          <strong>Pro-Tip for Fast Downloads:</strong> If your browser opens the video in a new tab instead of immediately downloading, right-click the video and select <em>"Save Video As..."</em> to store it on your drive.
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .guide-article {
    padding: 60px 0 80px;
  }

  .guide-container {
    max-width: 820px;
  }

  .guide-title {
    font-size: 2.6rem;
    font-weight: 800;
    margin: 16px 0 8px;
    color: var(--text-primary);
    line-height: 1.25;
  }

  .guide-meta {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 32px;
  }

  .guide-body {
    padding: 44px;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .guide-body .lead {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 24px;
  }

  .guide-body h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 32px 0 14px;
  }

  .guide-body p {
    margin-bottom: 16px;
  }

  .guide-body ul {
    margin-left: 24px;
    margin-bottom: 24px;
  }

  .guide-body li {
    margin-bottom: 8px;
  }

  .text-link {
    color: var(--orange-500);
    font-weight: 600;
    text-decoration: underline;
  }

  code {
    background: var(--bg-surface-alt);
    border: 1px solid var(--border-subtle);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
    color: var(--rose-600);
  }

  .tip-box {
    margin-top: 32px;
    background: var(--orange-50);
    border-left: 4px solid var(--orange-500);
    padding: 18px 22px;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .guide-body {
      padding: 24px;
    }
    .guide-title {
      font-size: 2rem;
    }
  }
</style>
