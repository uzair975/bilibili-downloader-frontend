---
---
<section id="results-section" class="results-section" style="display: none;">
  <div class="card results-card">
    <!-- Header with video info -->
    <div class="video-meta-grid">
      <div class="thumbnail-wrapper">
        <img id="res-thumbnail" src="" alt="Video thumbnail" class="res-thumbnail" referrerpolicy="no-referrer" />
        <span id="res-duration" class="res-duration">00:00</span>
      </div>

      <div class="video-details">
        <div class="meta-tags">
          <span class="badge-tag" id="res-bvid">BV...</span>
          <span class="view-tag" id="res-views">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
            <span id="res-views-count">0</span> views
          </span>
        </div>

        <h2 id="res-title" class="video-title">Video Title</h2>

        <div class="author-row">
          <img id="res-avatar" src="" alt="Author Avatar" class="author-avatar" referrerpolicy="no-referrer" />
          <span id="res-author" class="author-name">Author</span>
        </div>
      </div>
    </div>

    <!-- Format Tabs -->
    <div class="format-tabs" role="tablist">
      <button type="button" class="tab-btn active" data-tab="tab-merged">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="23 7 16 12 23 17 23 7"></polygon>
          <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
        </svg>
        Video + Audio
      </button>

      <button type="button" class="tab-btn" data-tab="tab-videos">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="23 7 16 12 23 17 23 7"></polygon>
          <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
        </svg>
        Video Only (DASH)
      </button>

      <button type="button" class="tab-btn" data-tab="tab-audios">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 18V5l12-2v13"></path>
          <circle cx="6" cy="18" r="3"></circle>
          <circle cx="18" cy="16" r="3"></circle>
        </svg>
        Audio (MP3 / M4A)
      </button>

      <button type="button" class="tab-btn" data-tab="tab-subs">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        Danmaku & Subtitles
      </button>
    </div>

    <!-- Merged (Video + Audio) Tab Panel -->
    <div id="tab-merged" class="tab-panel active">
      <p class="tab-hint">🎬 These downloads include <strong>both video and audio</strong> in a single MP4 file — recommended for most users.</p>
      
      <div class="dash-notice-box">
        <span class="dash-notice-icon">💡</span>
        <div class="dash-notice-content">
          <span>Looking for <strong>1080P Full HD</strong> or higher? Bilibili packages single-file MP4s up to 720P. For 1080P Full HD video streams, visit the</span>
          <button type="button" class="btn-link-switch" id="switch-to-dash-btn">Video Only (DASH) tab &rarr;</button>
        </div>
      </div>

      <div class="stream-table-wrapper">
        <table class="stream-table">
          <thead>
            <tr>
              <th>Quality</th>
              <th>Est. Size</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="merged-streams-body">
            <!-- Injected dynamically -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Video Only Tab Panel -->
    <div id="tab-videos" class="tab-panel">
      <p class="tab-hint">⚠️ DASH video streams contain <strong>no audio</strong>. Download a separate audio track from the Audio tab and merge them with a tool like FFmpeg.</p>
      <div class="stream-table-wrapper">
        <table class="stream-table">
          <thead>
            <tr>
              <th>Resolution</th>
              <th>Codec</th>
              <th>FPS</th>
              <th>Est. Size</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="video-streams-body">
            <!-- Injected dynamically -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Audio Tab Panel -->
    <div id="tab-audios" class="tab-panel">
      <div class="stream-table-wrapper">
        <table class="stream-table">
          <thead>
            <tr>
              <th>Quality</th>
              <th>Bitrate</th>
              <th>Format</th>
              <th>Est. Size</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="audio-streams-body">
            <!-- Injected dynamically -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Subtitles Tab Panel -->
    <div id="tab-subs" class="tab-panel">
      <div id="subs-container" class="subs-container">
        <!-- Injected dynamically -->
      </div>
    </div>
  </div>
</section>

<script>
  let currentResolutionData = null;

  window.addEventListener('bili:resolved', (e) => {
    const data = e.detail;
    if (!data) return;
    currentResolutionData = data;
    renderResults(data);
  });

  function renderResults(data) {
    const section = document.getElementById('results-section');
    if (!section) return;

    // Fill metadata
    const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
    const apiBase = isLocal ? 'http://127.0.0.1:8000' : 'https://bilibili-downloader-backend-vpif.onrender.com';

    function resolveMediaUrl(u) {
      if (!u) return '';
      if (u.startsWith('/')) {
        return `${apiBase}${u}`;
      }
      if (!isLocal) {
        return u.replace(/^http:\/\/(127\.0\.0\.1|localhost):8000/, apiBase);
      }
      return u;
    }

    const thumbnail = document.getElementById('res-thumbnail') as HTMLImageElement | null;
    if (thumbnail && data.thumbnail) {
      thumbnail.referrerPolicy = 'no-referrer';
      thumbnail.src = data.thumbnail;
      thumbnail.onerror = () => {
        if (!thumbnail.src.includes('/api/v1/download')) {
          thumbnail.src = resolveMediaUrl(`${apiBase}/api/v1/download?url=${encodeURIComponent(data.thumbnail)}&type=image`);
        }
      };
    }

    const duration = document.getElementById('res-duration');
    if (duration) duration.textContent = data.duration_formatted || '00:00';

    const bvid = document.getElementById('res-bvid');
    if (bvid) bvid.textContent = data.bvid || '';

    const views = document.getElementById('res-views-count');
    if (views) views.textContent = (data.views || 0).toLocaleString();

    const title = document.getElementById('res-title');
    if (title) title.textContent = data.title || 'Bilibili Video';

    const avatar = document.getElementById('res-avatar') as HTMLImageElement | null;
    if (avatar && data.author_avatar) {
      avatar.referrerPolicy = 'no-referrer';
      avatar.src = data.author_avatar;
      avatar.onerror = () => {
        if (!avatar.src.includes('/api/v1/download')) {
          avatar.src = `${apiBase}/api/v1/download?url=${encodeURIComponent(data.author_avatar)}&type=image`;
        }
      };
    }

    const author = document.getElementById('res-author');
    if (author) author.textContent = data.author_name || 'Creator';

    // Render Merged (Video + Audio) Streams
    const mergedBody = document.getElementById('merged-streams-body');
    if (mergedBody) {
      if (!data.merged || data.merged.length === 0) {
        mergedBody.innerHTML = '<tr><td colspan="3" class="empty-cell">No merged streams available. Try the Video Only + Audio tabs instead.</td></tr>';
      } else {
        mergedBody.innerHTML = data.merged.map(m => `
          <tr>
            <td>
              <div class="quality-cell">
                <span class="quality-badge merged-badge">${m.quality}P</span>
                <strong>${m.label}</strong>
              </div>
            </td>
            <td>${m.size_formatted || 'Auto'}</td>
            <td>
              <a href="${resolveMediaUrl(m.download_url)}" target="_blank" rel="noopener" class="btn-primary btn-sm">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Download MP4
              </a>
            </td>
          </tr>
        `).join('');
      }
    }

    // Render Video Only (DASH) Streams
    const videoBody = document.getElementById('video-streams-body');
    if (videoBody) {
      if (!data.videos || data.videos.length === 0) {
        videoBody.innerHTML = '<tr><td colspan="5" class="empty-cell">No video streams found.</td></tr>';
      } else {
        videoBody.innerHTML = data.videos.map(v => `
          <tr>
            <td>
              <div class="quality-cell">
                <span class="quality-badge">${v.quality}P</span>
                <strong>${v.label}</strong>
              </div>
            </td>
            <td><span class="codec-tag">${v.codec}</span></td>
            <td>${v.fps} fps</td>
            <td>${v.size_formatted || 'Auto'}</td>
            <td>
              <a href="${resolveMediaUrl(v.download_url)}" target="_blank" rel="noopener" class="btn-primary btn-sm">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Download MP4
              </a>
            </td>
          </tr>
        `).join('');
      }
    }

    // Render Audio Streams
    const audioBody = document.getElementById('audio-streams-body');
    if (audioBody) {
      if (!data.audios || data.audios.length === 0) {
        audioBody.innerHTML = '<tr><td colspan="5" class="empty-cell">No audio streams found.</td></tr>';
      } else {
        audioBody.innerHTML = data.audios.map(a => `
          <tr>
            <td>
              <div class="quality-cell">
                <span class="quality-badge audio-badge">${a.bitrate}</span>
                <strong>${a.label}</strong>
              </div>
            </td>
            <td>${a.bitrate}</td>
            <td><span class="codec-tag">M4A / MP3</span></td>
            <td>${a.size_formatted || 'Auto'}</td>
            <td>
              <a href="${resolveMediaUrl(a.download_url)}" target="_blank" rel="noopener" class="btn-primary btn-sm">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Download Audio
              </a>
            </td>
          </tr>
        `).join('');
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // Render Subtitles & Danmaku
    const subsContainer = document.getElementById('subs-container');
    if (subsContainer) {
      let html = '';

      // Danmaku XML card
      if (data.danmaku_url) {
        html += `
          <div class="sub-item">
            <div class="sub-info">
              <span class="badge-tag">Interactive Comments</span>
              <h4>Danmaku Flying Comments (XML)</h4>
              <p class="sub-desc">Synchronized bullet comments compatible with Danmaku-capable media players.</p>
            </div>
            <a href="${resolveMediaUrl(data.danmaku_url)}" target="_blank" rel="noopener" class="btn-secondary">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Download XML
            </a>
          </div>
        `;
      }

      if (data.subtitles && data.subtitles.length > 0) {
        data.subtitles.forEach(s => {
          html += `
            <div class="sub-item">
              <div class="sub-info">
                <span class="badge-tag">${escapeHtml(s.lang)}</span>
                <h4>${escapeHtml(s.label)} Subtitles</h4>
                <p class="sub-desc">Converted directly to standard SRT format for VLC and media players.</p>
              </div>
              <a href="${resolveMediaUrl(s.url)}" target="_blank" rel="noopener" class="btn-secondary">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Download SRT
              </a>
            </div>
          `;
        });
      }

      if (!html) {
        html = '<p class="empty-cell">No subtitles or danmaku available for this video.</p>';
      }

      subsContainer.innerHTML = html;
    }

    section.style.display = 'block';
  }

  // Tabs switching logic
  const tabBtns = document.querySelectorAll('.tab-btn');
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));

      btn.classList.add('active');
      const targetId = btn.getAttribute('data-tab');
      const targetPanel = document.getElementById(targetId);
      if (targetPanel) targetPanel.classList.add('active');
    });
  });

  document.getElementById('switch-to-dash-btn')?.addEventListener('click', () => {
    const dashTabBtn = document.querySelector('.tab-btn[data-tab="tab-videos"]');
    if (dashTabBtn) (dashTabBtn as HTMLElement).click();
  });
</script>

<style>
  .dash-notice-box {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 107, 0, 0.08);
    border: 1px solid rgba(255, 107, 0, 0.25);
    border-radius: var(--radius-md);
    padding: 12px 16px;
    margin-bottom: 20px;
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .dash-notice-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .dash-notice-content {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }

  .btn-link-switch {
    background: none;
    border: none;
    color: var(--orange-600);
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
    font-size: 0.9rem;
  }

  .btn-link-switch:hover {
    color: var(--rose-600);
  }

  .results-section {
    margin-top: 40px;
    margin-bottom: 60px;
  }

  .results-card {
    padding: 32px;
  }

  .video-meta-grid {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .thumbnail-wrapper {
    position: relative;
    width: 260px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-surface-alt);
    flex-shrink: 0;
    box-shadow: var(--shadow-sm);
  }

  .res-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .res-duration {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(17, 24, 39, 0.85);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .video-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .meta-tags {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .view-tag {
    font-size: 0.85rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .video-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .author-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 6px;
  }

  .author-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border-subtle);
  }

  .author-name {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  /* Format Tabs */
  .format-tabs {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
    border-bottom: 2px solid var(--border-subtle);
  }

  .tab-btn {
    background: transparent;
    border: none;
    padding: 12px 18px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    position: relative;
    margin-bottom: -2px;
    transition: color var(--transition-fast);
  }

  .tab-btn:hover {
    color: var(--orange-500);
  }

  .tab-btn.active {
    color: var(--orange-500);
    border-bottom: 2px solid var(--orange-500);
  }

  .tab-btn.active svg {
    color: var(--rose-500);
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
    animation: fadeIn 0.25s ease-in;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .tab-hint {
    font-size: 0.88rem;
    color: var(--text-secondary);
    background: var(--bg-surface-alt);
    padding: 10px 16px;
    border-radius: var(--radius-sm);
    margin-bottom: 16px;
    line-height: 1.5;
  }

  /* Table wrapper */
  .stream-table-wrapper {
    overflow-x: auto;
  }

  @media (max-width: 640px) {
    .video-meta-grid {
      flex-direction: column;
    }
    .thumbnail-wrapper {
      width: 100%;
    }
    .sub-item {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<style is:global>
  /* Dynamically rendered Stream Table with clean row separation */
  .stream-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 10px; /* Clean 10px separation between each download row */
    text-align: left;
  }

  .stream-table th {
    padding: 8px 16px;
    background: transparent;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
  }

  .stream-table tbody tr {
    background: var(--bg-surface-alt);
    transition: background var(--transition-fast), transform var(--transition-fast);
  }

  .stream-table tbody tr:hover {
    background: #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .stream-table td {
    padding: 12px 18px;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.95rem;
    color: var(--text-primary);
    vertical-align: middle;
  }

  .stream-table td:first-child {
    border-left: 1px solid var(--border-subtle);
    border-top-left-radius: var(--radius-md);
    border-bottom-left-radius: var(--radius-md);
  }

  .stream-table td:last-child {
    border-right: 1px solid var(--border-subtle);
    border-top-right-radius: var(--radius-md);
    border-bottom-right-radius: var(--radius-md);
    text-align: right;
  }

  .quality-cell {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .quality-badge {
    background: var(--orange-50);
    color: var(--orange-600);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid var(--orange-100);
  }

  .audio-badge {
    background: var(--rose-50);
    color: var(--rose-600);
    border-color: var(--rose-100);
  }

  .merged-badge {
    background: #ecfdf5;
    color: #059669;
    border-color: #a7f3d0;
  }

  .codec-tag {
    font-family: monospace;
    font-size: 0.85rem;
    color: var(--text-secondary);
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    padding: 2px 8px;
    border-radius: 4px;
  }

  /* Download Action Buttons - Clean spacing and balanced shadows */
  .stream-table .btn-sm {
    padding: 8px 18px;
    font-size: 0.88rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 4px 0;
    box-shadow: 0 2px 8px rgba(244, 63, 94, 0.22);
    white-space: nowrap;
  }

  .stream-table .btn-sm svg {
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .stream-table .btn-sm:hover svg {
    transform: translateY(1px);
  }

  .empty-cell {
    text-align: center;
    padding: 32px;
    color: var(--text-muted);
  }

  /* Subtitles list */
  .subs-container {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .sub-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-surface-alt);
    gap: 16px;
  }

  .sub-info h4 {
    font-size: 1rem;
    margin: 4px 0 2px;
  }

  .sub-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
</style>
