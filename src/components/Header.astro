      <a href="/tools/bilibili-danmaku-subtitle/" class={`quick-pill ${isLinkActive('/tools/bilibili-danmaku-subtitle') ? 'active' : ''}`}>
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>Subtitles</span>
      </a>
      <a href="/guides/how-to-download-bilibili-videos/" class={`quick-pill ${isLinkActive('/guides/how-to-download-bilibili-videos') ? 'active' : ''}`}>
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
        </svg>
        <span>Guides</span>
      </a>
      <a href="/legal/privacy-policy/" class={`quick-pill ${isLinkActive('/legal/privacy-policy') ? 'active' : ''}`}>
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
