    </button>
  </div>

  <!-- Mobile Quicklinks Horizontal Strip (Dynamic Active Highlight) -->
  <div class="mobile-quickbar" aria-label="Quick links">
    <div class="quickbar-inner">
      <a href="/" class={`quick-pill ${isLinkActive('/') ? 'active' : ''}`}>
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2">
          <rect x="2" y="7" width="20" height="15" rx="3" ry="3"></rect>
          <polyline points="17 2 12 7 7 2"></polyline>
        </svg>
        <span>Universal</span>
      </a>
      <a href="/tools/bilibili-1080p-hd/" class={`quick-pill ${isLinkActive('/tools/bilibili-1080p-hd') ? 'active' : ''}`}>
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <span>1080p HD</span>
      </a>
      <a href="/tools/bilibili-to-mp3/" class={`quick-pill ${isLinkActive('/tools/bilibili-to-mp3') ? 'active' : ''}`}>
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M9 18V5l12-2v13"></path>
          <circle cx="6" cy="18" r="3"></circle>
          <circle cx="18" cy="16" r="3"></circle>
        </svg>
        <span>Audio (MP3)</span>
      </a>
      <a href="/bilibili-thumbnail-downloader/" class={`quick-pill ${isLinkActive('/bilibili-thumbnail-downloader') ? 'active' : ''}`}>
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
        <span>Thumbnail</span>
