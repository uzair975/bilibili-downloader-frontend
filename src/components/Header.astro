  </div>

  <!-- Mobile Dropdown Drawer -->
  <div class="mobile-drawer" id="mobile-drawer">
    <nav class="drawer-nav">
      <a href="/" class={`drawer-link ${isLinkActive('/') ? 'active' : ''}`}>
        <span class="drawer-icon">🏠</span>
        <span>Universal Downloader</span>
      </a>
      <a href="/tools/bilibili-1080p-hd/" class={`drawer-link ${isLinkActive('/tools/bilibili-1080p-hd') ? 'active' : ''}`}>
        <span class="drawer-icon">🎬</span>
        <span>1080p Full HD Downloader</span>
      </a>
      <a href="/tools/bilibili-to-mp3/" class={`drawer-link ${isLinkActive('/tools/bilibili-to-mp3') ? 'active' : ''}`}>
        <span class="drawer-icon">🎵</span>
        <span>Bilibili to MP3 Converter</span>
      </a>
      <a href="/bilibili-thumbnail-downloader/" class={`drawer-link ${isLinkActive('/bilibili-thumbnail-downloader') ? 'active' : ''}`}>
        <span class="drawer-icon">🖼️</span>
        <span>Thumbnail / Cover Downloader</span>
        <span class="drawer-badge">HD</span>
      </a>
      <a href="/tools/bilibili-danmaku-subtitle/" class={`drawer-link ${isLinkActive('/tools/bilibili-danmaku-subtitle') ? 'active' : ''}`}>
        <span class="drawer-icon">💬</span>
        <span>Danmaku & Subtitles (XML/SRT)</span>
      </a>
      <div class="drawer-divider"></div>
      <a href="/guides/how-to-download-bilibili-videos/" class={`drawer-link ${isLinkActive('/guides/how-to-download-bilibili-videos') ? 'active' : ''}`}>
        <span class="drawer-icon">📖</span>
        <span>How to Download Videos (Guide)</span>
      </a>
      <a href="/legal/privacy-policy/" class={`drawer-link ${isLinkActive('/legal/privacy-policy') ? 'active' : ''}`}>
        <span class="drawer-icon">🔒</span>
        <span>Privacy Policy</span>
      </a>
      <a href="/legal/copyright-disclaimer/" class={`drawer-link ${isLinkActive('/legal/copyright-disclaimer') ? 'active' : ''}`}>
        <span class="drawer-icon">⚖️</span>
        <span>Copyright & DMCA</span>
      </a>
      <a href="/legal/contact/" class={`drawer-link ${isLinkActive('/legal/contact') ? 'active' : ''}`}>
        <span class="drawer-icon">✉️</span>
        <span>Contact & Support</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const hamburgerIcon = menuBtn?.querySelector('.hamburger-icon') as HTMLElement | null;
  const closeIcon = menuBtn?.querySelector('.close-icon') as HTMLElement | null;

  function toggleMenu() {
    const isOpen = drawer?.classList.toggle('is-open');
    menuBtn?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    if (hamburgerIcon && closeIcon) {
      hamburgerIcon.style.display = isOpen ? 'none' : 'block';
      closeIcon.style.display = isOpen ? 'block' : 'none';
    }
    if (isOpen) {
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.overflow = '';
    }
  }

  menuBtn?.addEventListener('click', toggleMenu);

  // Close drawer on link click
  drawer?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      if (drawer.classList.contains('is-open')) {
        toggleMenu();
      }
    });
  });

  // Auto scroll active pill into visible viewport on mobile
  const activePill = document.querySelector('.quick-pill.active');
  if (activePill) {
    activePill.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  }
</script>

<style>
  .site-header {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(10px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .brand-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--gradient-primary);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(255, 107, 0, 0.25);
  }

  .brand-icon svg {
    width: 20px;
    height: 20px;
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
    position: relative;
    padding: 6px 0;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--orange-500);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: var(--gradient-primary);
    transition: width var(--transition-fast);
    border-radius: 2px;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  /* Mobile Hamburger Button */
  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    padding: 8px;
    color: var(--text-primary);
    cursor: pointer;
    border-radius: 8px;
    transition: background var(--transition-fast);
  }

  .mobile-menu-btn:hover {
    background: var(--bg-surface-alt);
  }

  /* Mobile Quicklinks Strip */
  .mobile-quickbar {
    display: none;
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    padding: 8px 12px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .mobile-quickbar::-webkit-scrollbar {
    display: none;
  }

  .quickbar-inner {
    display: flex;
    align-items: center;
    gap: 8px;
    width: max-content;
    padding-right: 12px;
  }

  .quick-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--bg-surface-alt);
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .quick-pill svg {
    transition: stroke var(--transition-fast);
  }

  /* Active State for Clicked / Current Page */
  .quick-pill.active {
    background: rgba(255, 107, 0, 0.12);
    border-color: var(--orange-500);
    color: var(--orange-600);
    box-shadow: 0 2px 6px rgba(255, 107, 0, 0.16);
    font-weight: 700;
  }

  .quick-pill.active svg {
    stroke: var(--orange-500);
  }

  .quick-pill:hover:not(.active) {
    color: var(--orange-500);
    border-color: var(--orange-400);
    background: #ffffff;
  }

  /* Mobile Drawer Menu */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: 68px;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    padding: 20px;
    overflow-y: auto;
    z-index: 99;
  }

  .mobile-drawer.is-open {
    display: block;
    animation: drawerSlide 0.22s ease-out;
  }

  @keyframes drawerSlide {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .drawer-nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .drawer-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 10px;
    font-size: 0.96rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: background var(--transition-fast);
  }

  .drawer-link:hover,
  .drawer-link:active {
    background: var(--bg-surface-alt);
    color: var(--orange-500);
  }

  .drawer-link.active {
    background: rgba(255, 107, 0, 0.08);
    border: 1px solid rgba(255, 107, 0, 0.25);
    color: var(--orange-600);
    font-weight: 700;
  }

  .drawer-icon {
    font-size: 1.15rem;
    width: 24px;
    text-align: center;
  }

  .drawer-badge {
    margin-left: auto;
    background: var(--gradient-primary);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 10px;
  }

  .drawer-divider {
    height: 1px;
    background: var(--border-subtle);
    margin: 12px 0;
  }

  /* Responsive Breakpoints */
  @media (max-width: 900px) {
    .desktop-nav {
      gap: 16px;
    }
    .desktop-nav .nav-link {
      font-size: 0.88rem;
    }
  }

  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }
    .mobile-menu-btn {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .mobile-quickbar {
      display: block;
    }
  }
</style>
