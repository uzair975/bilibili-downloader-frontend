---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const isLinkActive = (target: string) => {
  const cleanTarget = target.replace(/\/$/, '') || '/';
  if (cleanTarget === '/') {
    return pathname === '/';
  }
  return pathname === cleanTarget || pathname.startsWith(cleanTarget + '/');
};
---
