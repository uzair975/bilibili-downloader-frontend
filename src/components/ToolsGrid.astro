---
export interface Props {
  currentPath?: string;
  title?: string;
  subtitle?: string;
}

const {
  currentPath = '',
  title = "Specialized Bilibili Tools",
  subtitle = "Choose from dedicated extraction engines tailored for video, audio, thumbnails, and comments."
} = Astro.props;

const allTools = [
  {
    title: "1080p Full HD Video Downloader",
    path: "/tools/bilibili-1080p-hd/",
    badge: "1080p 60FPS",
    desc: "Download pristine high-definition videos with synced DASH audio streams. Zero login, watermarks, or quality loss.",
    icon: "video"
  },
  {
    title: "Bilibili to MP3 Audio Converter",
    path: "/tools/bilibili-to-mp3/",
    badge: "320 kbps MP3",
    desc: "Extract studio-grade background music, anime soundtracks, ASMR, and vocal tracks in 320kbps MP3 / M4A formats.",
    icon: "music"
  },
  {
    title: "Thumbnail & Cover Downloader",
    path: "/bilibili-thumbnail-downloader/",
    badge: "Original HD",
    desc: "Save original full-resolution video thumbnails and cover art in JPG/PNG format for wallpaper and design use.",
    icon: "image"
  },
  {
    title: "Danmaku & Subtitles Extractor",
    path: "/tools/bilibili-danmaku-subtitle/",
    badge: "XML • SRT • ASS",
    desc: "Extract flying Danmaku bullet comments in XML format and closed caption subtitles in SRT/ASS for VLC and PotPlayer.",
    icon: "subtitles"
  }
];

const tools = allTools.filter(t => !currentPath || t.path !== currentPath);
---

<section class="tools-grid-section">
  <div class="section-header">
    <div class="badge-tag">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
      </svg>
      Specialized Utilities
    </div>
    <h2 class="section-title">{title}</h2>
    <p class="section-subtitle">{subtitle}</p>
  </div>

  <div class="tools-cards-grid">
    {tools.map((tool) => (
      <a href={tool.path} class="card tool-card">
        <div class="tool-card-top">
          <div class="tool-icon">
            {tool.icon === 'video' && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
              </svg>
            )}
            {tool.icon === 'music' && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 18V5l12-2v13"></path>
                <circle cx="6" cy="18" r="3"></circle>
                <circle cx="18" cy="16" r="3"></circle>
              </svg>
            )}
            {tool.icon === 'image' && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
            )}
            {tool.icon === 'subtitles' && (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
            )}
          </div>
          <span class="tool-badge">{tool.badge}</span>
        </div>
        <h3 class="tool-card-title">{tool.title}</h3>
        <p class="tool-card-desc">{tool.desc}</p>
        <div class="tool-card-action">
          <span>Open Tool</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .tools-grid-section {
    padding: 60px 0;
  }

  .section-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
  }

  .tools-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }

  .tool-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .tool-card:hover {
    transform: translateY(-4px);
    border-color: var(--orange-300);
    box-shadow: 0 12px 28px rgba(255, 107, 0, 0.12);
  }

  .tool-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .tool-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--gradient-primary);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(255, 107, 0, 0.2);
  }

  .tool-badge {
    background: var(--orange-50);
    color: var(--orange-600);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 107, 0, 0.2);
  }

  .tool-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 10px;
  }

  .tool-card-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .tool-card-action {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--orange-500);
    margin-top: auto;
    transition: gap var(--transition-fast);
  }

  .tool-card:hover .tool-card-action {
    gap: 10px;
  }
</style>
