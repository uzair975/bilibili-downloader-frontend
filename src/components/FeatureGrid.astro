---
const features = [
  {
    title: "Zero Login & No Account Needed",
    desc: "Directly extract any public Bilibili video stream without providing personal credentials, cookies, or scanning QR codes.",
    icon: "shield"
  },
  {
    title: "1080p Full HD & High Frame Rates",
    desc: "Enjoy pristine 1080p, 720p, and 60FPS video quality. DASH streams are properly handled so you never lose video quality.",
    icon: "video"
  },
  {
    title: "Studio-Grade 320 kbps MP3 Audio",
    desc: "Extract background tracks, anime songs, or podcasts straight from Bilibili videos into crystal-clear MP3 / M4A audio files.",
    icon: "music"
  },
  {
    title: "Danmaku Flying Comments & Subs",
    desc: "Download full XML bullet comment streams and official multi-language closed captions for offline playback.",
    icon: "message"
  },
  {
    title: "Ultra-Fast Edge CDN Bypass",
    desc: "Integrated referer spoofing proxies bypass 403 Forbidden CDN blocks, delivering maximum download speeds.",
    icon: "zap"
  },
  {
    title: "Cross-Device Compatible",
    desc: "Works natively on Windows, macOS, iPhone, iPad, Android, and Linux without installing extensions or third-party apps.",
    icon: "device"
  }
];
---

<section class="feature-grid-section">
  <div class="section-header">
    <div class="badge-tag">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
      </svg>
      Key Advantages
    </div>
    <h2 class="section-title">Engineered for Seamless Bilibili Extraction</h2>
    <p class="section-subtitle">A high-performance toolkit designed to make downloading Bilibili media fast, simple, and safe.</p>
  </div>

  <div class="features-grid">
    {features.map((feat) => (
      <div class="card feature-card">
        <div class="feature-icon">
          {feat.icon === 'shield' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          )}
          {feat.icon === 'video' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="23 7 16 12 23 17 23 7"></polygon>
              <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
            </svg>
          )}
          {feat.icon === 'music' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18V5l12-2v13"></path>
              <circle cx="6" cy="18" r="3"></circle>
              <circle cx="18" cy="16" r="3"></circle>
            </svg>
          )}
          {feat.icon === 'message' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
          )}
          {feat.icon === 'zap' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          )}
          {feat.icon === 'device' && (
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          )}
        </div>
        <h3 class="feature-title">{feat.title}</h3>
        <p class="feature-desc">{feat.desc}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .feature-grid-section {
    padding: 60px 0;
  }

  .section-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--gradient-subtle);
    color: var(--rose-500);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    border: 1px solid rgba(244, 63, 94, 0.15);
  }

  .feature-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 10px;
  }

  .feature-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
