---
export interface Props {
  placeholder?: string;
  buttonText?: string;
  initialFormat?: string;
}

const {
  placeholder = "Paste Bilibili link here (e.g., https://www.bilibili.com/video/BV1... or b23.tv/...)",
  buttonText = "Download Now",
  initialFormat = "all",
} = Astro.props;
---

<div class="downloader-card animate-glow">
  <form id="downloader-form" class="downloader-form" data-format={initialFormat}>
    <div class="input-wrapper">
      <div class="input-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
        </svg>
      </div>

      <input
        type="url"
        id="video-url-input"
        name="url"
        class="video-url-input"
        placeholder={placeholder}
        required
        autocomplete="off"
        spellcheck="false"
      />

      <button type="button" id="paste-btn" class="paste-btn" title="Paste from clipboard">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
          <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
        </svg>
        <span>Paste</span>
      </button>

      <button type="button" id="clear-btn" class="clear-btn" title="Clear input" style="display: none;">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <button type="submit" id="submit-btn" class="btn-primary submit-btn">
      <span class="btn-text">{buttonText}</span>
      <span class="btn-icon">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </span>
      <span class="spinner" style="display: none;">
        <svg class="animate-spin" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
          <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"></path>
        </svg>
      </span>
    </button>
  </form>

  <div id="form-error" class="form-error" style="display: none;">
    <div class="error-icon">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
    </div>
    <span id="error-message">Error resolving video.</span>
  </div>
</div>

<script>
  const form = document.getElementById('downloader-form');
  const input = document.getElementById('video-url-input');
  const pasteBtn = document.getElementById('paste-btn');
  const clearBtn = document.getElementById('clear-btn');
  const submitBtn = document.getElementById('submit-btn');
  const btnText = submitBtn?.querySelector('.btn-text');
  const btnIcon = submitBtn?.querySelector('.btn-icon');
  const spinner = submitBtn?.querySelector('.spinner');
  const errorBox = document.getElementById('form-error');
  const errorMsg = document.getElementById('error-message');

  // Show/hide clear button
  input?.addEventListener('input', () => {
    if (clearBtn) {
      clearBtn.style.display = input.value ? 'flex' : 'none';
    }
  });

  clearBtn?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      clearBtn.style.display = 'none';
      input.focus();
    }
  });

  // Paste from clipboard
  pasteBtn?.addEventListener('click', async () => {
    try {
      const text = await navigator.clipboard.readText();
      if (text && input) {
        input.value = text.trim();
        if (clearBtn) clearBtn.style.display = 'flex';
        input.focus();
      }
    } catch (err) {
      console.warn('Clipboard read failed', err);
    }
  });

  // Form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const url = input?.value.trim();
    if (!url) return;

    // Reset error
    if (errorBox) errorBox.style.display = 'none';

    // Show loading state
    if (submitBtn) submitBtn.disabled = true;
    if (btnIcon) btnIcon.style.display = 'none';
    if (spinner) spinner.style.display = 'inline-flex';
    if (btnText) btnText.textContent = 'Resolving Streams...';

    try {
      // Backend API endpoint: relative in dev proxy or default to port 8000
      const apiUrl = (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1')
        ? 'http://127.0.0.1:8000/api/v1/resolve'
        : '/api/v1/resolve';

      const response = await fetch(apiUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ url })
      });

      const data = await response.json();

      if (!response.ok || !data || data.success === false) {
        const errDetail = data?.error || data?.detail || 'Failed to extract video streams.';
        showError(errDetail);
        return;
      }

      // Dispatch resolution event to results component
      window.dispatchEvent(new CustomEvent('bili:resolved', { detail: data }));

      // Smooth scroll to results
      setTimeout(() => {
        const resultsEl = document.getElementById('results-section');
        if (resultsEl) {
          resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, 100);

    } catch (err) {
      console.error(err);
      showError('Unable to connect to the extraction engine. Please ensure the backend is running.');
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (btnIcon) btnIcon.style.display = 'inline-flex';
      if (spinner) spinner.style.display = 'none';
      if (btnText) btnText.textContent = 'Download Now';
    }
  });

  function showError(msg) {
    if (errorBox && errorMsg) {
      errorMsg.textContent = msg;
      errorBox.style.display = 'flex';
    }
  }
</script>

<style>
  .downloader-card {
    background: var(--bg-surface);
    border: 2px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 14px;
    box-shadow: var(--shadow-lg);
    max-width: 820px;
    margin: 0 auto;
    transition: border-color var(--transition-fast);
  }

  .downloader-card:focus-within {
    border-color: var(--orange-500);
  }

  .downloader-form {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .input-wrapper {
    flex: 1;
    display: flex;
    align-items: center;
    background: var(--bg-surface-alt);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 6px 16px;
    gap: 10px;
    position: relative;
    transition: all var(--transition-fast);
  }

  .input-wrapper:focus-within {
    background: #ffffff;
    border-color: var(--orange-500);
    box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.12);
  }

  .input-icon {
    color: var(--orange-500);
    display: flex;
    align-items: center;
  }

  .video-url-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 1rem;
    color: var(--text-primary);
    padding: 8px 0;
  }

  .video-url-input::placeholder {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .paste-btn, .clear-btn {
    border: none;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--rose-600);
    padding: 6px 12px;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: all var(--transition-fast);
  }

  .paste-btn:hover {
    background: var(--rose-50);
    border-color: var(--rose-500);
  }

  .clear-btn {
    padding: 6px;
    color: var(--text-muted);
  }

  .clear-btn:hover {
    color: var(--rose-600);
  }

  .submit-btn {
    padding: 14px 28px;
    font-size: 1.05rem;
    white-space: nowrap;
    min-width: 170px;
  }

  .form-error {
    margin-top: 14px;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    background: var(--rose-50);
    border: 1px solid rgba(244, 63, 94, 0.25);
    color: var(--rose-600);
    font-size: 0.92rem;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .error-icon {
    display: flex;
    align-items: center;
  }

  @media (max-width: 720px) {
    .downloader-form {
      flex-direction: column;
    }
    .input-wrapper {
      width: 100%;
    }
    .submit-btn {
      width: 100%;
    }
  }
</style>
